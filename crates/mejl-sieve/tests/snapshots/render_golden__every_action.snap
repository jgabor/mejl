# >>> mejl managed block v1 (do not edit by hand) >>>
# mejl:rule id=r_act name="Every action in user order" enabled=1
if address :domain :is "from" "example.com" {
  addflag "\\Flagged";
  addflag "\\Seen";
  fileinto :copy :mailboxid "Ml1" "INBOX.Label";
  fileinto :mailboxid "Mw1" "INBOX.Work.Clients";
  fileinto :specialuse "\\Trash" "INBOX.Trash";
}
# mejl:rule id=r_inbox name="Back to the Inbox" enabled=1
if true {
  fileinto :mailboxid "Minbox" "INBOX";
}
